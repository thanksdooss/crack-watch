{
  "$comment": "전처리 파라미터 단일 정의. web(TS)과 ml(Python)이 모두 이 파일을 읽는다. 하드코딩 금지.",
  "version": 1,
  "input": {
    "tile": 512,
    "overlap": 64,
    "interpolation": "bilinear",
    "colorSpace": "RGB"
  },
  "normalize": {
    "mean": [
      0.485,
      0.456,
      0.406
    ],
    "std": [
      0.229,
      0.224,
      0.225
    ]
  },
  "calibration": {
    "patch": {
      "rows": 2,
      "cols": 3,
      "swatches": [
        "white",
        "gray50",
        "black",
        "red",
        "blue",
        "gray18"
      ],
      "targetSrgb": {
        "white": [
          243,
          243,
          242
        ],
        "gray50": [
          122,
          122,
          121
        ],
        "black": [
          52,
          52,
          52
        ],
        "red": [
          175,
          54,
          60
        ],
        "blue": [
          56,
          61,
          150
        ],
        "gray18": [
          85,
          85,
          85
        ]
      }
    },
    "deltaEThreshold": {
      "good": 3.0,
      "fair": 6.0
    },
    "card": {
      "$comment": "기준 카드 치수(mm, 좌하단 원점, y 위로). PDF 생성기·파이썬 검출기·웹 검출기가 모두 여기서 읽는다.",
      "w": 90.0,
      "h": 56.0,
      "fiducialSize": 7.0,
      "fiducialMargin": 3.0,
      "swatchMm": 12.0,
      "swatchGap": 2.0,
      "gridX0": 25.0,
      "gridY0": 20.0,
      "rulerX0": 15.0,
      "rulerY0": 12.0,
      "rulerLen": 60.0
    }
  },
  "measure": {
    "profileHalfWidthPx": 12,
    "minCrackLengthPx": 24,
    "minAspectRatio": 4.0,
    "resolutionFloorPx": 0.5,
    "minMeasurablePx": 1.5,
    "representativePercentile": 90,
    "maxScaleUncertainty": 0.15,
    "guidance": {
      "$comment": "안내 전환점일 뿐 안전 판정이 아니다. 근거: 건축물 안전점검 및 정밀안전진단 세부지침(2003, 건설교통부·한국시설안전기술공단) — 응력에 의한 균열폭 0.3mm 초과 시 보수. 오차 범위 상단이 이 값에 닿으면 보수적으로 '전문가 점검 권장'.",
      "expertReviewMm": 0.3
    },
    "method": "hybrid",
    "hybridSwitchPx": 4.0,
    "profileSmoothFrac": 0.1,
    "$methodComment": "합성 dev에서 선택(test 미사용): 폭 4px 미만은 넓이 기반(흐림에 강함), 이상은 반치폭. 반치폭은 마스크 단면 길이의 10%만큼 평활해 균열 바닥의 기공·부스러기에 끌려가지 않게 한다. docs/decisions.md"
  },
  "classic": {
    "$comment": "고전 CV 기준선 파라미터. 3라운드 격자 탐색(합성 dev + CrackSeg9k val, test 미사용)으로 확정. 상위 설정 간 허용 F1 차이 < 0.005로 평평해져 탐색 종료. ml/baseline/tune.py",
    "flattenSigma": 20.0,
    "scales": [
      2.0,
      3.0,
      4.0,
      6.0
    ],
    "beta": 0.5,
    "c": 0.5,
    "hystHigh": 0.3,
    "hystLow": 0.2,
    "minLengthPx": 32,
    "minElongation": 8.0
  },
  "model": {
    "$comment": "val에서 고름(헛경보 상한 10%). ml.train.threshold",
    "file": "crack_unet_fp32.onnx",
    "threshold": 0.6,
    "minArea": 0,
    "$fileComment": "8비트 양자화는 가는 균열 출력을 무너뜨려(원본 대비 마스크 IoU 0.08~0.33) 32비트를 배포한다. docs/results/quantization.json"
  }
}
